# Optional: the shared password for the Basic-auth gate. Leave empty for a public site.
SITE_PASSWORD=
# Optional white-label overrides.
NEXT_PUBLIC_BUSINESS_NAME="Juniper & Moss Wellness Spa"
NEXT_PUBLIC_BUSINESS_SHORT="Juniper & Moss"
# Set to "false" to hide the "Sample data" pill and allow indexing.
NEXT_PUBLIC_DEMO=true
# Folder of YYYY-MM report folders (default: reports).
REPORTS_DIR=reports
